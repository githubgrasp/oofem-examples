# Local working notes — not for the public repo
CLAUDE.md

# Maintainer-only build/publish scripts (hard-code local paths and the
# githubgrasp account). End users pull from ghcr.io instead.
build-private.sh
build-public.sh
build-save-all.sh
push-public.sh
save-private.sh

# Image build recipes — kept out of the public repo because the private
# variant references T3D (closed-source, licensed). End users pull the
# pre-built image from ghcr.io.
Dockerfile.private
Dockerfile.public

# Maintainer-only working folder inside any example directory — animation
# scripts, hero figures for blog posts / LinkedIn, scratch artefacts.
# Not for end-user reproduction.
**/local/

# macOS
.DS_Store

# Editor backups
*~
.#*
\#*\#

# Saved-image tarballs (built by save-private.sh, intended for OneDrive)
oofem-private-*.tar.gz
oofem-public-*.tar.gz

# OOFEM / mesh-tool runtime artefacts (regenerated by run.sh; cleaned by
# clean.sh). `oofem.in` and `ld.dat` are intentionally NOT excluded —
# some examples commit `oofem.in` as a fallback for users without T3D,
# and `ld.dat` is small enough to ship as a precomputed result so
# readers can plot without running the full analysis.
**/oofem.out
**/oofem.out.*
**/std.out
**/mesh.out
**/mesh.nodes
**/mesh.voronoi
**/*.vtu
**/*.pvtu
**/*.pvd
**/*.osf
