#@cylinderinclusion 1 line 6 0. 0. 0. 10.e-3 0. 0. radius 8.e-3 itz 0.1e-3 inside 2 interface 3
#@bodyload 3 3
#@controlvertex 1 coords 3 0.     0. 0.
#@controlvertex 2 coords 3 10.e-3 0. 0.
